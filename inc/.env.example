# =============================================================================
# CEM (Custom Email Management) Webhook Environment Variables
# =============================================================================
# Copy this file to 'inc/.env' (local dev) or one level above public_html
# on Hostinger production. NEVER commit the real .env file to git.
#
# Source: CEM Admin → Accounts → "Custom Sofa Prices" → Webhook section
# =============================================================================

# Full webhook endpoint URL (CEM Admin → Accounts → edit → Webhook → Payload URL)
CEM_WEBHOOK_URL=

# 48-character hex secret (CEM Admin → Accounts → edit → Webhook → Secret)
CEM_WEBHOOK_SECRET=

# Comma-separated list of allowed origins for CORS
# e.g. https://cutomsofaprices.com,https://www.cutomsofaprices.com
CEM_ALLOWED_ORIGIN=

# (Optional) Explicit path to a CA certificate bundle for SSL verification.
# Leave blank to auto-discover. Useful for XAMPP or custom PHP installs.
# e.g. C:\xampp\php\extras\cacert.pem
CEM_CA_BUNDLE=
